{
  "name": "portable-tape-player",
  "version": "0.2.7",
  "private": true,
  "type": "module",
  "description": "Editable research reconstruction and self-contained viewer",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "build:viewer": "node tools/build.mjs --viewer",
    "test": "node tools/test.mjs",
    "test:fast": "node tools/test.mjs --suite=fast",
    "test:release": "node tools/test.mjs --suite=release",
    "check": "node tools/validate.mjs",
    "accept": "node tools/accept.mjs"
  },
  "dependencies": {
    "esbuild": "0.28.1",
    "three": "0.185.1"
  }
}
